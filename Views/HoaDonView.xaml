<UserControl x:Class="QL_CFE_WPF.Views.HoaDonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Padding="10"
                Margin="0,0,0,10"
                CornerRadius="5">

            <StackPanel>

                <TextBlock Text="TRA CỨU HÓA ĐƠN"
                           FontSize="22"
                           FontWeight="Bold"/>

                <WrapPanel Margin="0,10,0,0">

                    <DatePicker Width="140"
                                Margin="5"
                                SelectedDate="{Binding TuNgay}" />

                    <DatePicker Width="140"
                                Margin="5"
                                SelectedDate="{Binding DenNgay}" />

                    <TextBox Width="150"
                             Margin="5"
                             Text="{Binding SoHoaDon}"
                             materialDesign:HintAssist.Hint="Số hóa đơn"/>

                   

                    <ComboBox Width="140"
                              Margin="5"
                              ItemsSource="{Binding TrangThaiFilters}"
                              SelectedItem="{Binding SelectedTrangThai}"
                              DisplayMemberPath="Name"/>

                    <Button Content="Tìm kiếm"
                            Width="120"
                            Margin="5"
                            Command="{Binding TimKiemCommand}"/>

                    <Button Content="Làm mới"
                            Width="120"
                            Margin="5"
                            Command="{Binding RefreshCommand}"/>

                </WrapPanel>

            </StackPanel>

        </Border>

        <!-- DANH SÁCH HÓA ĐƠN -->

        <GroupBox Grid.Row="1"
                  Header="Danh sách hóa đơn">

            <DataGrid ItemsSource="{Binding HoaDons}"
                      SelectedItem="{Binding SelectedHoaDon}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.RowStyle>

                    <Style TargetType="DataGridRow">

                        <Style.Triggers>

                            <!-- Đang phục vụ -->
                            <DataTrigger Binding="{Binding TrangThai}"
                             Value="0">

                                <Setter Property="Background"
                            Value="LightSteelBlue"/>

                            </DataTrigger>

                            <!-- Hoàn tất -->
                            <DataTrigger Binding="{Binding TrangThai}"
                             Value="1">

                                <Setter Property="Background"
                            Value="LightGreen"/>

                            </DataTrigger>

                            <!-- Hủy -->
                            <DataTrigger Binding="{Binding TrangThai}"
                             Value="9">

                                <Setter Property="Background"
                            Value="#FFD6D6"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Số HĐ"
                                        Width="140"
                                        Binding="{Binding SoHoaDon}"/>

                    <DataGridTextColumn Header="Bàn"
                                        Width="120"
                                        Binding="{Binding Ban.TenBan}"/>

                    <DataGridTextColumn Header="Thu ngân"
                                        Width="140"
                                        Binding="{Binding NhanVien.TenHienThi}"/>

                    <DataGridTextColumn Header="Ngày TT"
                                        Width="160"
                                        Binding="{Binding NgayThanhToan,
                                          StringFormat=dd/MM/yyyy HH:mm}"/>

                    <DataGridTextColumn Header="Tổng tiền"
                                        Width="120"
                                        Binding="{Binding TongTien,
                                          StringFormat=N0}"/>

                    <DataGridTextColumn Header="Giảm giá"
                                        Width="120"
                                        Binding="{Binding TienGiamGia,
                                          StringFormat=N0}"/>

                    <DataGridTextColumn Header="VAT"
                                        Width="100"
                                        Binding="{Binding TienVAT,
                                          StringFormat=N0}"/>
                    <DataGridTextColumn Header="Thành Tiền"
                      Width="100"
                      Binding="{Binding ThanhTien,
                        StringFormat=N0}"/>

                    <DataGridTextColumn Header="Lần in"
                                        Width="80"
                                        Binding="{Binding LanIn}"/>
                    <DataGridTextColumn
    Header="Trạng thái"
    Binding="{Binding TrangThaiText}" />

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- CHI TIẾT -->

        <GroupBox Grid.Row="2"
                  Margin="0,10,0,10"
                  Header="Chi tiết hóa đơn">

            <DataGrid ItemsSource="{Binding ChiTiets}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Tên sản phẩm"
                                        Width="*"
                                        Binding="{Binding SanPham.TenSP}"/>

                    <DataGridTextColumn Header="SL"
                                        Width="80"
                                        Binding="{Binding SoLuong}"/>

                    <DataGridTextColumn Header="Đơn giá"
                                        Width="120"
                                        Binding="{Binding Gia,
                                          StringFormat=N0}"/>

                    <DataGridTextColumn Header="Thành tiền"
                                        Width="150"
                                        Binding="{Binding ThanhTien,
                                          StringFormat=N0}"/>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>

        <!-- BUTTONS -->

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="🖨 In lại Bill"
                    Width="150"
                    Height="40"
                    Margin="5"
                    Command="{Binding InLaiCommand}"/>

            <Button Content="📊 Xuất Excel"
                    Width="150"
                    Height="40"
                    Margin="5"
                    Command="{Binding ExportExcelCommand}"/>

            <Button Content="❌ Hủy hóa đơn"
                    Width="150"
                    Height="40"
                    Margin="5"
                    Command="{Binding HuyHoaDonCommand}"/>

        </StackPanel>

    </Grid>

</UserControl>