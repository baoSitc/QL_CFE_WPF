<UserControl x:Class="QL_CFE_WPF.Views.BaoCaoHangHoa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QL_CFE_WPF.Views"
             xmlns:vm="clr-namespace:QL_CFE_WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:BaoCaoHangHoaViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔍 FILTER -->
        <Border Background="#F5F5F5" Padding="10" CornerRadius="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox Width="180"
              ItemsSource="{Binding DanhSachKieu}"
              SelectedItem="{Binding KieuDangChon}"
              Margin="5"/>

                <TextBlock Text="Từ ngày:" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding TuNgay}" Margin="5"/>

                <TextBlock Text="Đến ngày:" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding DenNgay}" Margin="5"/>

                <Button Content="Xem báo cáo"
                    Width="120"
                    Height="30"
                    Margin="10,0"
                    Command="{Binding LoadBaoCaoHangHoaCommand}"/>
                <Button Content="🖨 In báo cáo"
    Width="120"
    Height="35"
    Margin="5"
    Command="{Binding InBaoCaoCommand}"/>
                
                <Button Content="📊 Xuất Excel"
    Width="120"
    Height="35"
    Margin="5"
    Command="{Binding ExportExcelCommand}"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="dgBaoCao" Grid.Row="1" ItemsSource="{Binding BaoCaoHangHoa}"
          AutoGenerateColumns="False"
          IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Tên SP"
                            Binding="{Binding TenSP}"
                            Width="2*"/>

                <DataGridTextColumn Header="Số lượng"
                            Binding="{Binding SoLuong}"
                            Width="100"/>

                <DataGridTextColumn Header="Đơn giá"
                            Binding="{Binding DonGia, StringFormat={}{0:N0}}"
                            Width="120"/>

                <DataGridTextColumn Header="Thành tiền"
                            Binding="{Binding ThanhTien, StringFormat={}{0:N0}}"
                            Width="150"/>

                <DataGridTextColumn Header="Ngày"
                            Binding="{Binding Ngay, StringFormat=dd/MM/yyyy HH:mm}"
                            Width="150"/>

                <DataGridTextColumn Header="Bàn"
                            Binding="{Binding SoBan}"
                            Width="80"/>

            </DataGrid.Columns>
        </DataGrid>
        <!-- 💰 TỔNG -->
        <Border Grid.Row="2" Background="#EEEEEE" Padding="10" CornerRadius="8">
            <TextBlock Text="{Binding TongTien, StringFormat=Tổng doanh thu: {0:N0} đ}"
               FontSize="18"
               FontWeight="Bold"
               Foreground="Red"
               HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>
