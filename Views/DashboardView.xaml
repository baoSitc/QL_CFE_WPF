
    <UserControl x:Class="QL_CFE_WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QL_CFE_WPF.Views"  
             xmlns:local1="clr-namespace:QL_CFE_WPF.Models"  
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" >
    <UserControl.Resources>
        <local1:EnumDescriptionConverter x:Key="EnumDesc"/>
    </UserControl.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- KPI -->
            <RowDefinition Height="350"/>
            <!-- CHART -->
            <RowDefinition Height="*"/>
            <!-- phần khác -->
        </Grid.RowDefinitions>

        <!-- 🔥 KPI CARD -->
        <UniformGrid Columns="3">

            <!-- 💰 DOANH THU -->
            <Border Style="{StaticResource KpiCardStyle}" Background="#4CAF50">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- TEXT -->
                    <StackPanel>
                        <TextBlock Text="Doanh thu hôm nay"
                           Foreground="White"
                           FontSize="13"/>

                        <TextBlock Text="{Binding DoanhThuHomNay, StringFormat={}{0:N0} đ}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>
                    </StackPanel>

                    <!-- ICON -->
                    <materialDesign:PackIcon Kind="Cash"
                                     Width="40"
                                     Height="40"
                                     Foreground="#80FFFFFF"
                                     Grid.Column="1"/>

                </Grid>

            </Border>

            <!-- 🧾 HÓA ĐƠN -->
            <Border Style="{StaticResource KpiCardStyle}" Background="#2196F3">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Hóa đơn"
                           Foreground="White"/>

                        <TextBlock Text="{Binding SoHoaDon}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>
                    </StackPanel>

                    <materialDesign:PackIcon Kind="Receipt"
                                     Width="40"
                                     Height="40"
                                     Foreground="#80FFFFFF"
                                     Grid.Column="1"/>
                </Grid>

            </Border>

            <!-- 🍽 BÀN -->
            <Border Style="{StaticResource KpiCardStyle}" Background="#FF9800">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Bàn đang dùng"
                           Foreground="White"/>

                        <TextBlock Text="{Binding SoBanDangDung}"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"/>
                    </StackPanel>

                    <materialDesign:PackIcon Kind="TableChair"
                                     Width="40"
                                     Height="40"
                                     Foreground="#80FFFFFF"
                                     Grid.Column="1"/>
                </Grid>

            </Border>

        </UniformGrid>

        <!-- 🔥 CHART -->
        <Grid Margin="10" Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 🔥 COMBO -->
                <RowDefinition Height="*"/>
                <!-- 🔥 CHART -->
            </Grid.RowDefinitions>

            <!-- 🔽 COMBOBOX -->
            <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="5">

                <TextBlock Text="Kiểu thống kê:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>

                <ComboBox Width="150"
                  ItemsSource="{Binding DanhSachKieu}"
                  SelectedItem="{Binding KieuDangChon}"/>                
            </StackPanel>
            <!-- 🔥 CHART -->
            <Border Grid.Row="1" Margin="5" Background="White" CornerRadius="10">
                <lvc:CartesianChart Grid.Row="1"
                    Series="{Binding Series}"
                    Margin="5"
                                    LegendLocation="Right">

                    <!-- TRỤC X -->
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Labels}"/>
                    </lvc:CartesianChart.AxisX>

                    <!-- 🔥 TRỤC Y FORMAT TIỀN -->
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis LabelFormatter="{Binding Formatter}"/>
                        <!-- 🪑 SỐ BÀN -->
                        <lvc:Axis Title="Số bàn"
                        Position="RightTop"/>
                    </lvc:CartesianChart.AxisY>
                   
                </lvc:CartesianChart>

            </Border>

        </Grid>
    </Grid>
</UserControl>
