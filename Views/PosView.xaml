<UserControl x:Class="QL_CFE_WPF.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QL_CFE_WPF.Views"
             xmlns:vm="clr-namespace:QL_CFE_WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:PosViewModel/>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <!-- CHIA HÀNG CHO CỘT TRÁI -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>          <!-- BÀN -->
                <RowDefinition Height="3*"/>           <!-- SẢN PHẨM -->
            </Grid.RowDefinitions>
            <!-- 🔥 GRID BÀN -->
            <ItemsControl ItemsSource="{Binding DanhSachBan}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="100"
                    Height="100"
                    Margin="8"
                    Command="{Binding DataContext.ChonBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="LightGreen"/>

                                    <Style.Triggers>

                                        <!-- 🔴 ĐANG DÙNG -->
                                        <DataTrigger Binding="{Binding DangSuDung}" Value="True">
                                            <Setter Property="Background" Value="Tomato"/>
                                        </DataTrigger>

                                        <!-- 🟡 ĐANG CHỌN -->
                                        <DataTrigger Binding="{Binding DangChon}" Value="True">
                                            <Setter Property="BorderBrush" Value="Yellow"/>
                                            <Setter Property="BorderThickness" Value="3"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TenBan}"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"/>

                                <TextBlock Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                            </StackPanel>

                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 🔥 DANH SÁCH SẢN PHẨM -->
            <ListBox Grid.Row="1" ItemsSource="{Binding SanPhams}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding TenSP}"
                            Margin="5"
                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>

        <!-- GIỎ HÀNG -->
        <StackPanel Grid.Column="1">
            <!-- MỞ BÀN -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBox Width="100"
                 Margin="5"
                 Text="{Binding MaBanNhap, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="Mở bàn"
                Command="{Binding TaoBanCommand}"
                Margin="5"/>
            </StackPanel>

            <!-- HIỂN THỊ BÀN -->
            <TextBlock Text="{Binding MaBanHienTai, StringFormat=Bàn: {0}}"
               FontWeight="Bold"
               Margin="5"/>
            <DataGrid x:Name="dgGioHang"
          ItemsSource="{Binding GioHang}"
          AutoGenerateColumns="False"
          MouseDoubleClick="dgGioHang_MouseDoubleClick"
          SelectionUnit="FullRow"
            IsReadOnly="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu
        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Xóa món"
                                  Background="LightBlue" 
                  Command="{Binding XoaMonCommand}"
                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                

                <DataGrid.Columns>
                   

                    <DataGridTextColumn Header="Tên Hàng" Binding="{Binding TenSP}" Width="*"/>
                    <DataGridTextColumn Header="Số Lượng" Binding="{Binding SoLuong}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- NÚT + -->
                    <DataGridTemplateColumn Header="+">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+"
         Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
         CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--NÚT-->
                    <DataGridTemplateColumn Header="-">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="-"
         Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
         CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--XÓA-->
                    <DataGridTemplateColumn Header="Xóa">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X"
                     Background="Red"
                     Foreground="White"
                     Command="{Binding DataContext.XoaMonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding}" />    
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Đơn Giá" Binding="{Binding Gia, StringFormat=N0}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>



                    <DataGridTextColumn Header="Thành Tiền"
                    Binding="{Binding ThanhTien, StringFormat=N0}"
                    Width="100">
                    
                    <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>




                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding TongTien, StringFormat=N0}" 
                   FontSize="20" 
                   FontWeight="Bold"
                       Foreground="BlueViolet"
                   HorizontalAlignment="Right"
                   Margin="5"/>

            <Button Content="THANH TOÁN"
                Command="{Binding ThanhToanCommand}"
                Height="40" Foreground="DarkBlue" FontSize="20" FontWeight="Bold" Background="Orange"/>
        </StackPanel>
        
    </Grid>
</UserControl>
