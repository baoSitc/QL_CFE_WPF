<UserControl x:Class="QL_CFE_WPF.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"             
             xmlns:local="clr-namespace:QL_CFE_WPF.Views"
             xmlns:vm="clr-namespace:QL_CFE_WPF.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:PathToImageConverter x:Key="ImgConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:PosViewModel/>
    </UserControl.DataContext>


    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <!-- CHIA HÀNG CHO CỘT TRÁI -->
        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <!-- BÀN -->
                <RowDefinition Height="3*"/>
                <!-- SẢN PHẨM -->
            </Grid.RowDefinitions>
            <!-- 🔥 GRID BÀN -->
            <Border BorderBrush="BlueViolet"
        BorderThickness="2"
        CornerRadius="10"
        Padding="5">
                <ItemsControl ItemsSource="{Binding DanhSachBan}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="100"
                    Height="100"
                    Margin="8"
                    Command="{Binding DataContext.ChonBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="LightGreen"/>

                                        <Style.Triggers>

                                            <!-- 🔴 ĐANG DÙNG -->
                                            <DataTrigger Binding="{Binding DangSuDung}" Value="True">
                                                <Setter Property="Background" Value="Tomato"/>
                                            </DataTrigger>

                                            <!-- 🟡 ĐANG CHỌN -->
                                            <DataTrigger Binding="{Binding DangChon}" Value="True">
                                                <Setter Property="BorderBrush" Value="Yellow"/>
                                                <Setter Property="BorderThickness" Value="4"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TenBan}"
                               FontWeight="Bold"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GioVao,StringFormat=HH:mm}"                                    
                                    FontSize="12"
                                            Foreground="White"
                                    HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding SoMon,StringFormat={}{0} món}"                                    
                                FontSize="12"
                                            Foreground="White"
                                 HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding TongTien, StringFormat={}{0:N0} đ}"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>

                                        <!-- Gộp bàn -->
                                        <MenuItem Header="Gộp bàn"
                      Command="{Binding PlacementTarget.Tag.GopBanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                        <!-- Chuyển bàn -->
                                        <MenuItem Header="Chuyển bàn"
                      Command="{Binding PlacementTarget.Tag.ChuyenBanCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                    </ContextMenu>
                                </Button.ContextMenu>

                                <!-- 🔥 QUAN TRỌNG: truyền ViewModel -->
                                <Button.Tag>
                                    <Binding Path="DataContext"
             RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </Button.Tag>


                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- SEARCH -->
                    <RowDefinition Height="*"/>
                    <!-- LIST -->
                </Grid.RowDefinitions>

                <!-- 🔍 SEARCH -->
                <TextBox Grid.Row="0"
             HorizontalAlignment="Center"
             Margin="0,5,0,5"
             Height="30"
             FontSize="14"
             materialDesign:HintAssist.Hint="Nhập tên sản phẩm cần tìm"
             Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" Width="292"/>

                <!-- 🔥 SCROLL -->
               
                    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <Border BorderBrush="BlueViolet"
BorderThickness="2"
CornerRadius="10"
Padding="5">
                        <ItemsControl ItemsSource="{Binding SanPhamsLoc}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="150"
           ItemHeight="200"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <materialDesign:Card 
                            
                             Margin="5"
                             Background="White" 
                             
                             Cursor="Hand"                             >

                                        <Button
                Background="Wheat" Height="200"
                BorderThickness="0"
                Padding="0"
                Command="{Binding DataContext.AddToCartCommand,
                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="4*"/>
                                                    <!-- Ảnh -->

                                                    <RowDefinition Height="3*"/>
                                                    <!-- Thông tin -->

                                                    <RowDefinition Height="*"/>
                                                    <!-- Nút -->
                                                </Grid.RowDefinitions>

                                                <!-- ================= IMAGE ================= -->

                                                <Grid Width="130"
                                                        Height="130">

                                                    <Ellipse>
                                                        <Ellipse.Fill>

                                                            <ImageBrush
                ImageSource="{Binding HinhAnh,
                Converter={StaticResource ImgConverter}}"/>

                                                        </Ellipse.Fill>
                                                    </Ellipse>

                                                </Grid>



                                                <!-- ================= INFO ================= -->

                                                <StackPanel Grid.Row="1"
                                Margin="10,5">

                                                    <!-- Tên sản phẩm -->

                                                    <TextBlock Text="{Binding TenSP}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="OrangeRed"
                                   MaxHeight="40"/>

                                                    <!-- Giá -->

                                                    <Grid Margin="0">

                                                      
                                                        <TextBlock FontWeight="Bold"
                                       FontSize="16" FontStyle="Normal" Foreground="Blue" TextAlignment="Center">

                                                           
                                <Run Text="{Binding GiaBan,StringFormat={}{0:N0}}"/>
                                <Run Text=" đ"/>

                                                        </TextBlock>                                                       

                                                    </Grid>

                                                </StackPanel>

                                                <!-- ================= BUTTON ================= -->

                                                <Border Grid.Row="2" Margin="0"
                           >

                                                    <TextBlock FontWeight="Bold"
                                                 FontSize="16" Foreground="Red" TextAlignment="Center">

                                                    <Run Text="{Binding GiaVIP,StringFormat={}{0:N0}}"/>
                                                    <Run Text=" đ"/>        

                                                    </TextBlock>

                                                </Border>

                                            </Grid>

                                        </Button>

                                    </materialDesign:Card>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </ScrollViewer>               
            </Grid>
        </Grid>



        <!-- GIỎ HÀNG -->
        <materialDesign:Card Grid.Column="1"
                     Margin="5"
                     Padding="10"
                     materialDesign:ShadowAssist.ShadowDepth="Depth3">

            <Grid>

                <!-- CHIA LAYOUT -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Tổng -->
                    <RowDefinition Height="Auto"/>
                    <!-- Giảm -->
                    <RowDefinition Height="Auto"/>
                    <!-- VAT -->
                    <RowDefinition Height="Auto"/>
                    <!-- Thành tiền -->
                    <RowDefinition Height="Auto"/>
                    <!-- Button -->
                </Grid.RowDefinitions>

                <!-- 🪑 HEADER -->
                <Border Grid.Row="0" Padding="8" Background="#EEE" CornerRadius="8">
                    <TextBlock Text="{Binding TenBanDangChon, StringFormat=Bạn đang phục vụ bàn: {0}}"
                       FontSize="20"
                       FontWeight="Bold" Foreground="DarkBlue"
                       HorizontalAlignment="Center"/>
                </Border>

                <!-- 🧾 GIỎ HÀNG (SCROLL) -->
                <DataGrid Grid.Row="1" x:Name="dgGioHang"
                  ItemsSource="{Binding GioHang}"
                  AutoGenerateColumns="False"
                  MouseDoubleClick="dgGioHang_MouseDoubleClick"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  Margin="0,10" Padding="5"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <ColorAnimation Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)" From="Yellow" To="Transparent" Duration="0:0:0.15"/>
                                                <!--nhấp nháy opacity-->
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.5" Duration="0:0:0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu
        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">

                            <MenuItem Header="Xóa món"
                  Command="{Binding XoaMonCommand}"
                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <!-- CỘT -->
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Tên"
                                    Binding="{Binding TenSP}" FontWeight="Bold"
                                    Width="3*"/>

                        <DataGridTextColumn Header="SL"
                                    Binding="{Binding SoLuong}" FontWeight="Bold"
                                    Width="50"/>

                        <DataGridTemplateColumn Header="+">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+"
                                    Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="-">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="-"
                                    Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Giá"
                                    Binding="{Binding Gia, StringFormat=N0}"
                                    Width="100"/>

                        <DataGridTextColumn Header="TT" 
                                    Binding="{Binding ThanhTien, StringFormat=N0}" FontWeight="Bold"
                                    Width="120" />

                    </DataGrid.Columns>
                </DataGrid>

                <!-- 💰 TỔNG -->
                <Grid Grid.Row="2" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tổng cộng:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1"
                       Text="{Binding TongTien, StringFormat=N0}"
                       FontWeight="Bold" FontSize="14"
                       Foreground="Blue"/>
                </Grid>

                <!-- 🎯 GIẢM GIÁ -->
                <Grid Grid.Row="3" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Giảm giá:" FontWeight="Bold"/>

                    <ComboBox Grid.Column="1"
                      Width="60"
                      ItemsSource="{Binding DanhSachGiamGia}"
                      SelectedItem="{Binding PhanTramGiam,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Column="2"
                     Width="100" TextAlignment="Right"
                     Text="{Binding GiamGia, StringFormat=N0}"/>
                </Grid>
                <!-- 🎯 VAT -->
                <Grid Grid.Row="4" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="VAT:" FontWeight="Bold"/>

                    <ComboBox Grid.Column="1"
        Width="60"
        ItemsSource="{Binding DanhSachGiamGia}"
        SelectedItem="{Binding PhanTramVAT,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBox Grid.Column="2"
       Width="100" TextAlignment="Right"
       Text="{Binding Vat, StringFormat=N0}"/>
                </Grid>

                <!-- 💵 THÀNH TIỀN -->
                <Grid Grid.Row="5" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Thành tiền:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1"
                       Text="{Binding TongTienHienTai, StringFormat=N0}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="Red"/>
                </Grid>

                <!-- 🔥 BUTTON -->
                <Button Grid.Row="6"
                Content="THANH TOÁN"
                Command="{Binding ThanhToanCommand}"
                Height="50"
                FontSize="18"
                FontWeight="Bold"
                Background="Orange"
                Foreground="White"
                Margin="5"/>

            </Grid>

        </materialDesign:Card>
    </Grid>
       
        
</UserControl>
