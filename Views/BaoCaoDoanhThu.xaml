<UserControl x:Class="QL_CFE_WPF.Views.BaoCaoDoanhThu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QL_CFE_WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔍 FILTER -->
        <Border Background="#F5F5F5" Padding="10" CornerRadius="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="Từ ngày:" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding TuNgay}" Margin="5"/>

                <TextBlock Text="Đến ngày:" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding DenNgay}" Margin="5"/>

                <Button Content="Xem báo cáo"
                        Width="120"
                        Height="30"
                        Margin="10,0"
                        Command="{Binding LoadBaoCaoChiTietCommand}"/>
                <Button Content="🖨 In báo cáo"
        Width="120"
        Height="35"
        Margin="5"
        Command="{Binding InBaoCaoCommand}"/>
                <Button Content="📊 Xuất Excel"
        Width="120"
        Height="35"
        Margin="5"
        Command="{Binding ExportExcelCommand}"/>
            </StackPanel>
        </Border>

        <!-- 📊 DATA GRID -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding BaoCaoChiTiet}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,10"
                  AlternatingRowBackground="#F9F9F9">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Số bàn"
                                    Binding="{Binding SoBan}"
                                    Width="80"/>

                <DataGridTextColumn Header="Giờ vào"
                                    Binding="{Binding GioVao, StringFormat=HH:mm}"
                                    Width="100"/>

                <DataGridTextColumn Header="Giờ ra"
                                    Binding="{Binding GioRa, StringFormat=HH:mm}"
                                    Width="100"/>
                <DataGridTextColumn Header="Tổng tiền"
                    Binding="{Binding ThanhTien, StringFormat={}{0:N0} đ}"
                    Width="150"/>

                <DataGridTextColumn Header="Giảm giá"
                                    Binding="{Binding GiamGia, StringFormat={}{0:N0}}"
                                    Width="100"/>

                <DataGridTextColumn Header="VAT"
                                    Binding="{Binding VAT, StringFormat={}{0:N0}}"
                                    Width="80"/>

                <DataGridTextColumn Header="Thành tiền"
                                    Binding="{Binding TongTien, StringFormat={}{0:N0} đ}"
                                    Width="150"/>

            </DataGrid.Columns>
        </DataGrid>

        <!-- 💰 TỔNG -->
        <Border Grid.Row="2" Background="#EEEEEE" Padding="10" CornerRadius="8">
            <TextBlock Text="{Binding TongDoanhThu, StringFormat=Tổng doanh thu: {0:N0} đ}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Red"
                       HorizontalAlignment="Right"/>
        </Border>

    </Grid>
</UserControl>
