<UserControl x:Class="QL_CFE_WPF.Views.NhanVienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:QL_CFE_WPF.Views"
             xmlns:models="clr-namespace:QL_CFE_WPF.Models"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <models:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- DANH SÁCH -->
        <DataGrid ItemsSource="{Binding DanhSach}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  Grid.Column="0" SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="User" Binding="{Binding TenDangNhap}"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding TenHienThi}"/>
                <DataGridTextColumn Header="Vai trò" Binding="{Binding VaiTro}"/>
                <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding TrangThai}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- FORM -->
        <StackPanel Grid.Column="1" Margin="10">

            <TextBox x:Name="txtTenDangNhap"
        Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
        Style="{StaticResource MaterialDesignOutlinedTextBox}"
        materialDesign:HintAssist.Hint="Tên đăng nhập"
        Margin="5"/>
            <!-- ICON -->
            <materialDesign:PackIcon
        Kind="AlertCircle"
        Foreground="Red"
        Width="20"
        Height="20"
        HorizontalAlignment="Right"
        Margin="0,0,10,0"
        Visibility="{Binding (Validation.HasError),
            RelativeSource={RelativeSource AncestorType=TextBox},
            Converter={StaticResource BoolToVisibility}}"/>

            <PasswordBox x:Name="txtPassword"
    Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
    materialDesign:HintAssist.Hint="Mật khẩu"
                         PasswordChanged="txtPassword_PasswordChanged"
    Margin="5"/>

            <TextBox
        Text="{Binding TenHienThi, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
        Style="{StaticResource MaterialDesignOutlinedTextBox}"
        materialDesign:HintAssist.Hint="Tên hiển thị"
        Margin="5"/>

            <ComboBox
        ItemsSource="{Binding DanhSachVaiTro}"
        SelectedItem="{Binding VaiTro, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
        Style="{StaticResource MaterialDesignOutlinedComboBox}"
        Margin="5"
        materialDesign:HintAssist.Hint="Vai trò"/>

            <CheckBox Content="Đang hoạt động"
              IsChecked="{Binding TrangThai}"
              Margin="10"/>
            <StackPanel Orientation="Horizontal" Margin="0,10">
                
                <Button Content="Thêm"
        Command="{Binding ThemCommand}">

                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <!-- 🔥 Khi TextBox có lỗi -->
                                <DataTrigger Binding="{Binding ElementName=txtTenDangNhap, Path=(Validation.HasError)}"
                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- 🔥 Kiểm tra IsValid -->
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- 🔥 Đang chọn dòng -->
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="Sửa" Command="{Binding SuaCommand}" Margin="5" IsEnabled="{Binding IsEditing}"/>
                <Button Content="Xóa" Command="{Binding XoaCommand}" Margin="5" IsEnabled="{Binding SelectedItem}"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
